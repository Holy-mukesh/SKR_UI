# Dependencies
node_modules/

# Next.js build output
.next/
out/
dist/
next-env.d.ts
*.tsbuildinfo

# Secrets: keep real values only in .env on your machine / server.
# .env.example (no real values) stays in git as the template.
.env
.env.*
!.env.example

# Local data (old db.json store and uploads) — lives at the project root only,
# so src/data (site content) is still tracked
/data/

# Hosting
.vercel/

# Logs
*.log
npm-debug.log*

# Editors and OS
.DS_Store
Thumbs.db
.vscode/
.idea/

# Claude Code: personal settings stay local, shared launch.json stays tracked
.claude/settings.local.json
